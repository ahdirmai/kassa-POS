# Production multi-stage Dockerfile for @pos/admin-api (Back Office API)
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.32.0 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/admin-api/package.json ./apps/admin-api/

RUN pnpm install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY apps/api/prisma ./apps/api/prisma
COPY apps/admin-api ./apps/admin-api

RUN pnpm --filter @pos/shared build
RUN pnpm --filter @pos/admin-api db:generate
RUN pnpm --filter @pos/admin-api build

FROM node:20-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.32.0 --activate
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/admin-api ./apps/admin-api

WORKDIR /app/apps/admin-api
EXPOSE 4001
CMD ["node", "dist/index.js"]
