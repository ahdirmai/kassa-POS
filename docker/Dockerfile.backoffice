# Production multi-stage Dockerfile for @pos/backoffice (Next.js 15 — admin.kassa.biz.id)
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.32.0 --activate
WORKDIR /app

ARG NEXT_PUBLIC_ADMIN_API_URL=https://admin-api.kassa.biz.id/api/v1
ARG NEXT_PUBLIC_LANDING_URL=https://kassa.biz.id
ENV NEXT_PUBLIC_ADMIN_API_URL=$NEXT_PUBLIC_ADMIN_API_URL
ENV NEXT_PUBLIC_LANDING_URL=$NEXT_PUBLIC_LANDING_URL

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/backoffice/package.json ./apps/backoffice/

RUN pnpm install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY apps/backoffice ./apps/backoffice

RUN pnpm --filter @pos/shared build
RUN pnpm --filter @pos/backoffice build

FROM node:20-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.32.0 --activate
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/backoffice ./apps/backoffice

WORKDIR /app/apps/backoffice
EXPOSE 3006
CMD ["pnpm", "start"]
