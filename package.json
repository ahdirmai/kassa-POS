{
  "name": "tumpu-pos-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @pos/api dev",
    "dev:admin-api": "pnpm --filter @pos/admin-api dev",
    "dev:web": "pnpm --filter @pos/web dev",
    "dev:landing": "pnpm --filter tumpu-landing dev",
    "dev:backoffice": "pnpm --filter @pos/backoffice dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @pos/api db:push",
    "db:migrate": "pnpm --filter @pos/api db:migrate",
    "db:seed": "pnpm --filter @pos/api db:seed",
    "db:studio": "pnpm --filter @pos/api db:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d mysql redis",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
