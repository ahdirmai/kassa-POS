# ==============================================================================
# TUMPU POS ECOSYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy ke .env (root untuk Docker prod, atau apps/api/.env & apps/admin-api/.env)
# ==============================================================================

# --- Database (MySQL 8) ---
MYSQL_ROOT_PASSWORD="change-me-strong-root-password"
MYSQL_DATABASE="pos_cafe"
MYSQL_USER="pos_user"
MYSQL_PASSWORD="change-me-strong-db-password"
DATABASE_URL="mysql://pos_user:pos_password@localhost:3316/pos_cafe"

# --- Redis ---
REDIS_URL="redis://localhost:6380"

# --- POS API (app-api.tumpu.biz.id · port 4000) ---
API_PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:3005"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-prod"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-prod"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7
PUBLIC_LANDING_URL="https://tumpu.biz.id"
APP_WEB_URL="http://localhost:3000"

# --- Email Confirmation (auto = Resend jika RESEND_API_KEY diisi, SMTP jika SMTP_HOST diisi, else console) ---
EMAIL_PROVIDER="auto"
EMAIL_FROM="Tumpu POS <noreply@tumpu.biz.id>"
# Rekomendasi untuk domain Cloudflare: Resend (gratis 3.000 email/bln + 1-click DNS Cloudflare)
RESEND_API_KEY=""
# Alternatif SMTP (Brevo / Mailgun / Zoho / Gmail App Password)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Back Office API (admin-api.tumpu.biz.id · port 4001) ---
ADMIN_API_PORT=4001
ADMIN_CORS_ORIGIN="http://localhost:3005,http://localhost:3006"
PLATFORM_JWT_ACCESS_SECRET="change-me-platform-access-secret-min-32-chars-prod"
PLATFORM_JWT_EXPIRES="8h"
PLATFORM_ADMIN_EMAIL="superadmin@tumpu.biz.id"
PLATFORM_ADMIN_PASSWORD="change-me-superadmin-password"
DEPLOY_AGENT_URL="http://host.docker.internal:9000"
DEPLOY_INTERNAL_TOKEN="change-me-32-byte-hex-deploy-internal-token"

# --- Midtrans QRIS Adapter ---
PAYMENT_PROVIDER="midtrans"
MIDTRANS_MODE="mock"
MIDTRANS_SERVER_KEY="SB-Mid-server-mock-key"
MIDTRANS_API_URL="https://api.sandbox.midtrans.com"

# --- POS Web (pos.tumpu.biz.id · port 3000) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_DEMO_MODE="false"

# --- Back Office Web (admin.tumpu.biz.id · port 3006) ---
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4001/api/v1"
NEXT_PUBLIC_LANDING_URL="http://localhost:3005"

# --- Landing Page (tumpu.biz.id · port 3005) ---
NEXT_PUBLIC_SITE_URL="https://tumpu.biz.id"
ADMIN_API_URL="http://localhost:4001/api/v1"
POS_API_URL="http://localhost:4000/api/v1"
ADMIN_SESSION_SECRET="change-me-landing-admin-secret-min-32-chars"
ADMIN_EMAIL="admin@tumpu.biz.id"
ADMIN_PASSWORD="change-me-landing-admin-password"
