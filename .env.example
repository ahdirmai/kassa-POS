# Database (MySQL 8)
DATABASE_URL="mysql://pos_user:pos_password@localhost:3316/pos_cafe"

# Redis (opsional di MVP, siap untuk BullMQ/cache)
REDIS_URL="redis://localhost:6380"

# API Server
API_PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:3005,http://localhost:3006"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-dev"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-dev"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Platform Back Office Auth (Terpisah dari Auth Tenant POS)
PLATFORM_JWT_ACCESS_SECRET="change-me-platform-access-secret-min-32-chars-dev"
PLATFORM_JWT_REFRESH_SECRET="change-me-platform-refresh-secret-min-32-chars-dev"
PLATFORM_ADMIN_EMAIL="superadmin@kassa.biz.id"
PLATFORM_ADMIN_PASSWORD="kassa-superadmin-2026"

# Midtrans QRIS Adapter (mode "mock" untuk sandbox lokal tanpa kredensial)
PAYMENT_PROVIDER="midtrans"
MIDTRANS_MODE="mock"
MIDTRANS_SERVER_KEY="SB-Mid-server-mock-key"
MIDTRANS_API_URL="https://api.sandbox.midtrans.com"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
